# Copie pra .env.local (que NÃO vai pro git) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Chave do Groq (https://console.groq.com/keys) — usada só pelo backend
GROQ_API_KEY=

# Opcional: modelo do Groq (padrão: llama-3.3-70b-versatile)
GROQ_MODEL=

# Opcional: endereço do chat no front (padrão: /api/chat). "off" = só respostas prontas
VITE_CHAT_ENDPOINT=
